{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carefully-crafted/contexthub/supervise/complexity.schema.json",
  "title": "Implementation complexity grade",
  "description": "Structured output required from the read-only Codex complexity grader (see plugins/contexthub/scripts/supervise/contracts.mjs:validateComplexity for the semantic layer enforced on top of this shape).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score",
    "confidence",
    "dimensions",
    "reasons",
    "risk_flags",
    "unknowns",
    "suggested_parallelism",
    "relevant_paths",
    "verification_hints"
  ],
  "properties": {
    "score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "uncertainty", "coupling", "risk", "verification"],
      "properties": {
        "scope": { "type": "integer", "minimum": 1, "maximum": 5 },
        "uncertainty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "coupling": { "type": "integer", "minimum": 1, "maximum": 5 },
        "risk": { "type": "integer", "minimum": 1, "maximum": 5 },
        "verification": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "reasons": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "risk_flags": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "suggested_parallelism": { "type": "integer", "minimum": 1, "maximum": 3 },
    "relevant_paths": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "verification_hints": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  }
}
